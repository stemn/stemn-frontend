{
  "name": "stemn-frontend",
  "version": "1.0.0",
  "private": true,
  "author": "David Revay <david@stemn.com>",
  "license": "MIT",
  "workspaces": [
    "stemn-frontend-shared",
    "stemn-frontend-website",
    "stemn-frontend-desktop",
    "tests/e2e"
  ],
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspace stemn-frontend-website",
    "build": "npm run build --workspace stemn-frontend-website",
    "serve": "npm run serve --workspace stemn-frontend-website",
    "dev:webpack": "npm run dev:webpack --workspace stemn-frontend-website",
    "build:webpack": "npm run build:webpack --workspace stemn-frontend-website",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspace stemn-frontend-website && npm run typecheck --workspace stemn-frontend-desktop && tsc -p tests/e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm test --workspace stemn-e2e",
    "desktop:dev": "npm run dev --workspace stemn-frontend-desktop",
    "desktop:build": "npm run build --workspace stemn-frontend-desktop",
    "desktop:start": "npm run start --workspace stemn-frontend-desktop",
    "desktop:package": "npm run package --workspace stemn-frontend-desktop",
    "desktop:test:e2e": "npm run test:e2e --workspace stemn-frontend-desktop",
    "desktop:typecheck": "npm run typecheck --workspace stemn-frontend-desktop",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stemn/stemn-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/stemn/stemn-frontend/issues"
  },
  "homepage": "https://github.com/stemn/stemn-frontend#readme",
  "overrides": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "redux-form": {
      "react-redux": "9.3.1",
      "redux": "5.0.1"
    },
    "katex": "0.19.1",
    "ansi-to-react": {
      "linkify-it": "5.0.2"
    }
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,html,yml,yaml}": "prettier --write"
  }
}
