{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "core",
  "description": "The hidden core window (the redux store that is the source of truth, like the Electron main process): store persistence, logging, auto-start and the FunctionLibrary commands (file cache, file save, windows, updates, provider paths).",
  "windows": ["core"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "store:allow-load",
    "store:allow-get-store",
    "store:allow-entries",
    "store:allow-set",
    "store:allow-clear",
    "store:allow-save",
    "log:allow-log",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "allow-core-launch-info",
    "allow-core-configure",
    "allow-core-broadcast",
    "allow-core-send",
    "allow-bridge-open-external",
    "allow-cache-get",
    "allow-cache-is-cached",
    "allow-cache-remove",
    "allow-save-file",
    "allow-provider-path",
    "allow-install-status",
    "allow-windows-create-preview",
    "allow-windows-show",
    "allow-windows-hide",
    "allow-app-quit",
    "allow-app-relaunch",
    "allow-tray-set-logged-in",
    "allow-shell-context",
    "allow-updater-supported",
    "allow-updater-check",
    "allow-updater-download",
    "allow-updater-install"
  ]
}
