{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // `.web.*` files win over the generic ones, like the bundlers' resolve.extensions
    "moduleSuffixes": [".web", ""],
    "paths": {
      "stemn-shared/*": ["../stemn-frontend-shared/src/*"],
      "modules/*": ["./src/client/assets/javascripts/modules/*"],
      "layout/*": ["./src/client/assets/javascripts/layout/*"],
      "pages/*": ["./src/client/assets/javascripts/pages/*"],
      "route-actions": ["./src/client/assets/javascripts/pages/routeActions.js"],
      "reducer": ["./src/client/assets/javascripts/app/reducer.ts"]
    }
  },
  "include": [
    "../typings.d.ts",
    "./src/client",
    "../stemn-frontend-shared/src"
  ],
  "exclude": [
    "../stemn-frontend-shared/src/desktop",
    "../stemn-frontend-shared/src/**/*.desktop.*",
    "../stemn-frontend-shared/src/**/*.electron.*",
    "../stemn-frontend-shared/src/**/*.test.ts",
    "../stemn-frontend-shared/src/**/*.test.tsx",
    "./src/**/*.test.ts"
  ]
}
