{
  "name": "stemn-frontend",
  "version": "1.0.0",
  "private": true,
  "author": "David Revay <david@stemn.com>",
  "license": "MIT",
  "workspaces": [
    "stemn-frontend-shared",
    "stemn-frontend-website",
    "stemn-frontend-desktop",
    "tests/e2e"
  ],
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "pnpm --filter stemn-frontend-website run dev",
    "build": "pnpm --filter stemn-frontend-website run build",
    "serve": "pnpm --filter stemn-frontend-website run serve",
    "dev:webpack": "pnpm --filter stemn-frontend-website run dev:webpack",
    "build:webpack": "pnpm --filter stemn-frontend-website run build:webpack",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter stemn-frontend-website run typecheck && pnpm --filter stemn-frontend-desktop run typecheck && tsc -p tests/e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter stemn-e2e test",
    "desktop:dev": "pnpm --filter stemn-frontend-desktop run dev",
    "desktop:build": "pnpm --filter stemn-frontend-desktop run build",
    "desktop:start": "pnpm --filter stemn-frontend-desktop run start",
    "desktop:package": "pnpm --filter stemn-frontend-desktop run package",
    "desktop:test:e2e": "pnpm --filter stemn-frontend-desktop run test:e2e",
    "desktop:typecheck": "pnpm --filter stemn-frontend-desktop run typecheck",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stemn/stemn-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/stemn/stemn-frontend/issues"
  },
  "homepage": "https://github.com/stemn/stemn-frontend#readme",
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "catalog:",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,html,yml,yaml}": "prettier --write"
  }
}
