{
  "name": "stemn-frontend-desktop",
  "productName": "Stemn",
  "version": "0.0.26",
  "private": true,
  "description": "Stemn Desktop: Versioning and project management",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stemn/Stemn-Desktop"
  },
  "main": "dist/main/index.js",
  "author": {
    "name": "STEMN Pty Ltd",
    "email": "desktop@stemn.com"
  },
  "license": "MIT",
  "homepage": "https://stemn.com",
  "bugs": {
    "url": "https://github.com/Stemn/Stemn-Desktop/issues",
    "email": "bugs@stemn.com"
  },
  "keywords": [
    "project management",
    "tracking",
    "versioning",
    "engineering",
    "science"
  ],
  "contributors": [
    "David Revay <david@stemn.com>",
    "Jackson Delahunt <jackson@stemn.com>"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "node scripts/electron-vite.mjs build",
    "start": "node scripts/electron-vite.mjs preview --skipBuild",
    "package": "npm run build && electron-builder --linux AppImage dir",
    "package:dir": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "package:check": "node scripts/check-builder-config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry/browser": "11.10.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-react": "6.1.2",
    "auto-launch": "5.0.6",
    "autoprefixer": "10.6.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-json-storage": "4.6.0",
    "electron-log": "5.4.4",
    "electron-squirrel-startup": "1.0.1",
    "electron-updater": "6.8.11",
    "electron-vite": "6.0.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "ini": "7.0.0",
    "redux-logger": "3.0.6",
    "redux-promise-middleware": "6.2.0",
    "redux-thunk": "3.1.0",
    "sass": "1.107.0",
    "sql.js": "1.15.2",
    "stemn-frontend-shared": "1.0.0",
    "typescript": "7.0.2",
    "unzipper": "0.12.5",
    "vite": "8.3.5",
    "winreg": "1.2.5"
  },
  "desktopName": "stemn.desktop"
}
