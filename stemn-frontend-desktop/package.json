{
  "name": "stemn-frontend-desktop",
  "productName": "Stemn",
  "version": "0.0.26",
  "private": true,
  "description": "Stemn Desktop: Versioning and project management",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stemn/Stemn-Desktop"
  },
  "main": "dist/main/index.js",
  "author": {
    "name": "STEMN Pty Ltd",
    "email": "desktop@stemn.com"
  },
  "license": "MIT",
  "homepage": "https://stemn.com",
  "bugs": {
    "url": "https://github.com/Stemn/Stemn-Desktop/issues",
    "email": "bugs@stemn.com"
  },
  "keywords": [
    "project management",
    "tracking",
    "versioning",
    "engineering",
    "science"
  ],
  "contributors": [
    "David Revay <david@stemn.com>",
    "Jackson Delahunt <jackson@stemn.com>"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "node scripts/electron-vite.mjs build",
    "start": "node scripts/electron-vite.mjs preview --skipBuild",
    "package": "pnpm run build && electron-builder --linux AppImage dir",
    "package:dir": "pnpm run build && electron-builder --dir",
    "package:win": "pnpm run build && electron-builder --win",
    "package:mac": "pnpm run build && electron-builder --mac",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "package:check": "node scripts/check-builder-config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@sentry/browser": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "auto-launch": "catalog:",
    "autoprefixer": "catalog:",
    "axios": "catalog:",
    "classnames": "catalog:",
    "electron": "catalog:",
    "electron-builder": "26.18.0",
    "electron-json-storage": "catalog:",
    "electron-log": "catalog:",
    "electron-squirrel-startup": "1.0.1",
    "electron-updater": "catalog:",
    "electron-vite": "6.0.0",
    "express": "catalog:",
    "express-rate-limit": "8.7.1",
    "immer": "catalog:",
    "ini": "catalog:",
    "lodash": "catalog:",
    "normalize.css": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-icons": "catalog:",
    "react-redux": "catalog:",
    "react-router": "catalog:",
    "redux": "catalog:",
    "redux-logger": "catalog:",
    "redux-promise-middleware": "catalog:",
    "redux-thunk": "catalog:",
    "sass": "catalog:",
    "sql.js": "catalog:",
    "stemn-frontend-shared": "workspace:*",
    "typescript": "catalog:",
    "unzipper": "catalog:",
    "vite": "catalog:",
    "winreg": "catalog:"
  },
  "desktopName": "stemn.desktop"
}
